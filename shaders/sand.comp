#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;

struct SandParticle {
    uint type;
    int life;
};

layout(std430, binding = 0) buffer Grid {
    SandParticle grid[];
};

uniform int uWidth;
uniform int uHeight;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    
    if (x >= uWidth || y >= uHeight - 1) return;
    
    int i = y * uWidth + x;
    
    if (grid[i].type != 1u) return;
    
    int below = (y + 1) * uWidth + x;
    if (grid[below].type == 0u) {
        grid[below].type = 1u;
        grid[i].type = 0u;
        return;
    }
    
    if (x > 0) {
        int belowLeft = (y + 1) * uWidth + (x - 1);
        if (grid[belowLeft].type == 0u) {
            grid[belowLeft].type = 1u;
            grid[i].type = 0u;
            return;
        }
    }
    
    if (x < uWidth - 1) {
        int belowRight = (y + 1) * uWidth + (x + 1);
        if (grid[belowRight].type == 0u) {
            grid[belowRight].type = 1u;
            grid[i].type = 0u;
        }
    }
}